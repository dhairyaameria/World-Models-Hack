# Copy to backend/.env and fill in. backend/.env is git-ignored.
GEMINI_API_KEY=
# mock = random decisions (no key needed), live = Gemini Robotics ER 2
AGENT_MODE=mock
DECISION_MIN_INTERVAL_MS=500
# Dead-reckoning calibration (P3): meters per second of W, degrees per second of look
SPEED_MPS=1.0
TURN_DPS=60
CORS_ORIGINS=http://localhost:3000
