# Copy to backend/.env and fill in. backend/.env is git-ignored.
GEMINI_API_KEY=
# mock = random decisions (no key needed), live = Gemini Robotics ER 2
AGENT_MODE=mock
DECISION_MIN_INTERVAL_MS=500
# Dead-reckoning calibration (P3): meters per second of W, degrees per second of look
SPEED_MPS=1.0
TURN_DPS=60
CORS_ORIGINS=http://localhost:3000
# Model IDs (defaults in app/genai_client.py; list yours with: python -m scripts.list_models)
# ER2_MODEL=gemini-robotics-er-2-preview
# ER2_STREAMING_MODEL=gemini-robotics-er-2-streaming-preview
# GEMINI_FLASH_MODEL=gemini-flash-latest
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# Live voice guide (P7): gemini-3.8-live
